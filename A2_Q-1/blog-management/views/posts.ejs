<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Published Blog Posts</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <div class="container">

        <div class="page-header">
            <div>
                <h1>Published Blog Posts</h1>
                <p>Explore all published posts</p>
            </div>

            <a href="/login" class="btn">
                Login
            </a>
        </div>

        <% if (posts.length === 0) { %>

            <div class="empty-message">
                <p>No published posts available.</p>
            </div>

        <% } else { %>

            <div class="posts-grid">

                <% posts.forEach(post => { %>

                    <div class="post-card">

                        <!-- Featured Image -->
                        <% if (post.image) { %>

                            <img
                                src="<%= post.image %>"
                                alt="<%= post.title %>"
                                class="post-image"
                            >

                        <% } %>


                        <!-- Post Content -->
                        <div class="post-content">

                            <h2>
                                <%= post.title %>
                            </h2>


                            <p class="post-author">
                                By <strong>
                                    <%= post.author.name %>
                                </strong>
                            </p>


                            <p>
                                <%= post.content %>
                            </p>


                            <!-- Tags -->
                            <% if (post.tags && post.tags.length > 0) { %>

                                <div class="tags">

                                    <% post.tags.forEach(tag => { %>

                                        <span class="tag">
                                            <%= tag %>
                                        </span>

                                    <% }) %>

                                </div>

                            <% } %>


                            <p class="post-date">

                                Published:
                                <%= new Date(post.createdAt).toLocaleDateString() %>

                            </p>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } %>

    </div>

</body>
</html>