<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Published Blog Posts</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <div class="container">
    <div class="page-header">
      <div>
        <h1>Published Blog Posts</h1>
        <p>Explore all published posts from our community.</p>
      </div>
      <div>
        <a href="/login" class="btn">Login</a>
        <a href="/register" class="btn btn-secondary">Register</a>
      </div>
    </div>

    <% if (posts && posts.length > 0) { %>
      <% posts.forEach(post => { %>
        <article class="post-card">
          <% if (post.image) { %>
            <img src="<%= post.image %>" alt="<%= post.title %>" class="post-card-image">
          <% } %>

          <div class="post-card-content">
            <h2 class="post-card-title"><%= post.title %></h2>
            <p class="post-card-author">By <strong><%= post.author ? post.author.name : 'Anonymous' %></strong></p>
            
            <p class="post-card-body"><%= post.content %></p>

            <% if (post.tags && post.tags.length > 0) { %>
              <div class="tags-container">
                <% post.tags.forEach(tag => { %>
                  <span class="tag-badge"><%= tag %></span>
                <% }); %>
              </div>
            <% } %>

            <p class="post-card-date">Published on <%= new Date(post.createdAt).toLocaleDateString() %></p>
          </div>
        </article>
      <% }); %>
    <% } else { %>
      <div class="card">
        <p>No published blog posts available yet.</p>
      </div>
    <% } %>
  </div>

</body>
</html>